  "whyUs": {
    "badge": "Why Choose Us",
    "title": "Why People Contact Us",
    "description": "See why so many customers trust our services",
    "benefits": {
      "costPerformance": {
        "title": "Cost Performance",
        "description": "We provide high-quality services at competitive prices compared to other companies. From a single rice cooker to entire property cleanouts, we maintain transparent and reasonable pricing for both individual and corporate clients. We've received high ratings from many customers on 'Kurashi no Market'."
      },
      "speedEfficiency": {
        "title": "Speed & Efficiency",
        "description": "Speed is one of our strengths. With our 'Service First' motto, we complete work as quickly as possible without compromising quality. Leveraging our experience handling over 100 monthly requests (currently over 150), we provide speedy service even during peak seasons in Tokyo, Kanagawa, Saitama, and Chiba areas."
      },
      "experiencedStaff": {
        "title": "Experienced Staff",
        "description": "Our staff brings extensive expertise in junk removal, virus disinfection, estate organization, pre-mortem sorting, and hoarding house cleaning to every project. We can also accommodate requests for female staff members for clients who prefer them (reservation required one week in advance)."
      }
    }
  },
  "team": {
    "title": "Our Team",
    "description": "Our team consists of professionals dedicated to providing the best service possible",
    "rating": "Rating 4.9",
    "certified": "Certified",
    "members": {
      "owner": {
        "name": "Manabu Umeda",
        "role": "Owner",
        "description": "Organizing a deceased person's belongings is more mentally burdening and challenging than one might imagine. Having lost both of my parents 15 years ago, I deeply understand the grief and hardship of bereaved families. That's why I prioritize the feelings of family members and work daily with the motto of 'compassionate organization of belongings.' More than anything, the moment when a client says 'thank you' is the greatest reward and joy for me."
      },
      "staff": {
        "name": "Kei Inagawa",
        "role": "Staff",
        "description": "I believe the true purpose of this work is to help bereaved families preserve precious memories in the best possible way as keepsakes, while continuing good deeds through the purchase, recycling, and donation of unwanted items. I dedicate myself daily to 'supporting with compassion' for those left behind."
      }
    }
  },
